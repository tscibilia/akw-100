{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/*.env": "deny",
      "**/.env.*": "deny",
      "**/*.env.*": "deny",
      "**/.envrc": "deny",
      "**/.env.example": "allow",
      "**/*.env.example": "allow",
      "**/.env.sample": "allow",
      "**/*.env.sample": "allow",
      "**/.env.template": "allow",
      "**/*.env.template": "allow",
      "**/.env.dist": "allow",
      "**/*.env.dist": "allow",
      "**/*.sqlite": "deny",
      "**/*.db": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/.kube/config": "deny",
      "**/talosconfig": "deny"
    },
    "edit": {
      "*": "allow",
      "**/.env": "deny",
      "**/*.env": "deny",
      "**/.env.*": "deny",
      "**/*.env.*": "deny",
      "**/.envrc": "deny",
      "**/.env.example": "allow",
      "**/*.env.example": "allow",
      "**/.env.sample": "allow",
      "**/*.env.sample": "allow",
      "**/.env.template": "allow",
      "**/*.env.template": "allow",
      "**/.env.dist": "allow",
      "**/*.env.dist": "allow",
      "**/*.sqlite": "deny",
      "**/*.db": "deny"
    },
    "bash": {
      "*": "allow",
      "pg_dump*": "deny",
      "pg_restore*": "deny",
      "sops -d*": "deny",
      "sops exec-env*": "deny",
      "printenv*": "deny",
      "ps eww*": "deny",
      "cat *.sqlite*": "deny",
      "env": "deny",
      "sqlite3*.dump*": "deny",
      "sqlite3*select *": "deny",
      "psql*select *": "deny",
      "akeyless get-secret-value*": "deny",
      "aws secretsmanager get-secret-value*": "deny",
      "gcloud secrets versions access*": "deny",
      "vault kv get*": "deny",
      "doppler secrets download*": "deny",
      "op item get*--reveal*": "deny"
    }
  },
  "mcp": {
    "litellm-homelab": {
      "type": "remote",
      "url": "https://litellm.t0m.co/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:LITELLM_API_KEY}",
        "x-mcp-servers": "context7_mcp,searxng_mcp,github_mcp,deepwiki_mcp"
      }
    },
    "memini": {
      "type": "remote",
      "url": "https://memini.t0m.co/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:MEMINI_API_KEY}",
        "X-Memini-Namespace": "tscibilia/akw-100"
      }
    }
  },
  "plugins": [
    {
      "package": "@eleboucher/opencode-memini-v2",
      "options": {
        "namespace": "tscibilia/akw-100",
        "base_url": "https://memini.t0m.co/",
        "recall_budget_ms": 8000
      }
    }
  ]
}
