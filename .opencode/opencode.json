{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/*.env": "deny",
      "**/.env.*": "deny",
      "**/*.env.*": "deny",
      "**/.envrc": "deny",
      "**/.env.example": "allow",
      "**/*.env.example": "allow",
      "**/.env.sample": "allow",
      "**/*.env.sample": "allow",
      "**/.env.template": "allow",
      "**/*.env.template": "allow",
      "**/.env.dist": "allow",
      "**/*.env.dist": "allow",
      "**/*.sqlite": "deny",
      "**/*.db": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/.kube/config": "deny",
      "**/talosconfig": "deny"
    },
    "edit": {
      "*": "allow",
      "**/.env": "deny",
      "**/*.env": "deny",
      "**/.env.*": "deny",
      "**/*.env.*": "deny",
      "**/.envrc": "deny",
      "**/.env.example": "allow",
      "**/*.env.example": "allow",
      "**/.env.sample": "allow",
      "**/*.env.sample": "allow",
      "**/.env.template": "allow",
      "**/*.env.template": "allow",
      "**/.env.dist": "allow",
      "**/*.env.dist": "allow",
      "**/*.sqlite": "deny",
      "**/*.db": "deny"
    },
    "bash": {
      "*": "allow",
      "pg_dump*": "deny",
      "pg_restore*": "deny",
      "sops -d*": "deny",
      "sops exec-env*": "deny",
      "printenv*": "deny",
      "ps eww*": "deny",
      "cat *.sqlite*": "deny",
      "env": "deny",
      "sqlite3*.dump*": "deny",
      "sqlite3*select *": "deny",
      "psql*select *": "deny",
      "akeyless get-secret-value*": "deny",
      "aws secretsmanager get-secret-value*": "deny",
      "gcloud secrets versions access*": "deny",
      "vault kv get*": "deny",
      "doppler secrets download*": "deny",
      "op item get*--reveal*": "deny"
    }
  }
}
